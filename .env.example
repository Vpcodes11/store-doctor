# Copy to .env (local) or add in Vercel → Settings → Environment Variables.

# REQUIRED. Your live address, no trailing slash (used for checkout return links)
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# REQUIRED. Postgres (Vercel → Storage → Neon sets both)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# REQUIRED in practice. Google Cloud → APIs & Services → enable "PageSpeed Insights API" → create an API key.
# Free; without a key Google allows very few tests per day.
PAGESPEED_API_KEY=

# Optional. AI copy suggestions (Google AI Studio key). Without it the report has no rewrite section.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# REQUIRED. Password for /admin (fix queue). Any username. At least 12 characters.
ADMIN_PASSWORD=

# REQUIRED to take payments: Dodo Payments (test_mode while testing, live_mode when live)
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
# One-time products created in Dodo (the _INR ones are optional)
DODO_PRODUCT_FULL_REPORT_USD=
DODO_PRODUCT_FULL_REPORT_INR=
DODO_PRODUCT_FIX_PACK_USD=
DODO_PRODUCT_FIX_PACK_INR=

# Secret for /api/health?key=... which lists missing settings. Generate: openssl rand -hex 16
HEALTH_KEY=
